# Environment configuration template
# Copy to .env and fill in values. Never commit real secrets.

# Vercel frontend API URL (used at build time)
VITE_API_URL=https://yantrax-backend.onrender.com

# Market data providers (at least one required for real data)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FMP_API_KEY=
FMP_KEY=

# AI/LLM providers
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=

# Broker credentials (paper trading only - do not enable without authorization)
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_ACCESS_TOKEN=
BINANCE_API_KEY=
BINANCE_SECRET=

# Security
JWT_SECRET_KEY=
CORS_ORIGINS=https://yantrax-rl.vercel.app,http://localhost:3000,http://localhost:5173

# Application flags
EMAIL_REPORTS=no
AI_FIRM_ENABLED=true
SUPERNATURAL_MODE=inactive